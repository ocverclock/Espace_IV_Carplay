 const clamp = (v: number, lo: number, hi: number): number => Math.max(lo, Math.min(hi, v))
 
+type EspaceGaugeConfig = {
+  radius: number
+  gapDeg: number
+  armTicks: number
+  ticks: number
+  majorCount: number
+  trailMax: number
+  tickW: number
+  tickH: number
+  majorH: number
+  labelSize: number
+  pointerW: number
+  pointerH: number
+  pointerRadius: number
+}
+
+const DEFAULT_GAUGE_CONFIG: EspaceGaugeConfig = {
+  radius: 110,
+  gapDeg: 180,
+  armTicks: 3,
+  ticks: 41,
+  majorCount: 6,
+  trailMax: 0.5,
+  tickW: 3,
+  tickH: 14,
+  majorH: 26,
+  labelSize: 15,
+  pointerW: 4,
+  pointerH: 38,
+  pointerRadius: 1.5
+}
+
+const gaugeNumber = (
+  source: Record<string, unknown>,
+  key: keyof EspaceGaugeConfig,
+  fallback: number,
+  min: number,
+  max: number,
+  integer = false
+): number => {
+  const raw = source[key]
+  if (typeof raw !== 'number' || !Number.isFinite(raw)) return fallback
+  const value = clamp(raw, min, max)
+  return integer ? Math.round(value) : value
+}
+
+const sanitizeGaugeConfig = (source: Record<string, unknown>): EspaceGaugeConfig => ({
+  radius: gaugeNumber(source, 'radius', 110, 80, 145),
+  gapDeg: gaugeNumber(source, 'gapDeg', 180, 120, 240),
+  armTicks: gaugeNumber(source, 'armTicks', 3, 0, 8, true),
+  ticks: gaugeNumber(source, 'ticks', 41, 11, 81, true),
+  majorCount: gaugeNumber(source, 'majorCount', 6, 2, 10, true),
+  trailMax: gaugeNumber(source, 'trailMax', 0.5, 0, 1),
+  tickW: gaugeNumber(source, 'tickW', 3, 1, 8),
+  tickH: gaugeNumber(source, 'tickH', 14, 6, 30),
+  majorH: gaugeNumber(source, 'majorH', 26, 12, 50),
+  labelSize: gaugeNumber(source, 'labelSize', 15, 10, 28),
+  pointerW: gaugeNumber(source, 'pointerW', 4, 2, 12),
+  pointerH: gaugeNumber(source, 'pointerH', 38, 18, 70),
+  pointerRadius: gaugeNumber(source, 'pointerRadius', 1.5, 0, 6)
+})
+
+const scaleLabels = (max: number, count: number, divisor = 1): string[] =>
+  Array.from({ length: Math.max(2, count) }, (_, index) => {
+    const value = (max * index) / Math.max(1, count - 1) / divisor
+    if (Number.isInteger(value)) return String(value)
+    return value.toFixed(1).replace(/\.0$/, '')
+  })
+
