+import { Box, Typography } from '@mui/material'
+import { type ReactNode, useEffect, useState } from 'react'
+import { DashShell } from '../../components/DashShell'
+import { useVehicleTelemetry } from '../../hooks/useVehicleTelemetry'
+
+const BASE_W = 1280
+const BASE_H = 720
+
+const stageScale = (w: number, h: number): number => {
+  const scale = Math.min(w / BASE_W, h / BASE_H)
+  return Number.isFinite(scale) && scale > 0 ? scale : 1
+}
+
+const stageOffset = (
+  w: number,
+  h: number,
+  scale: number
+): { left: number; top: number } => ({
+  left: Math.round((w - BASE_W * scale) / 2),
+  top: Math.round((h - BASE_H * scale) / 2)
+})
+
+const isNumber = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isFinite(value)
+
+const numberValue = (value: unknown, decimals = 0): string =>
+  isNumber(value) ? value.toFixed(decimals) : '--'
+
+type MetricProps = {
+  label: string
+  value: string
+  unit?: string
+  alert?: boolean
+}
+
+function Metric({ label, value, unit, alert = false }: MetricProps) {
+  return (
+    <Box className="espace-metric">
+      <Typography className="espace-metric-label">
+        {label}
+      </Typography>
+
+      <Box className="espace-metric-reading">
+        <Typography
+          component="span"
+          className={`espace-metric-value${alert ? ' espace-alert' : ''}`}
+        >
+          {value}
+        </Typography>
+
+        {unit && value !== '--' && (
+          <Typography
+            component="span"
+            className="espace-metric-unit"
+          >
+            {unit}
+          </Typography>
+        )}
+      </Box>
+    </Box>
+  )
+}
+
+function Section({
+  title,
+  className,
+  children
+}: {
+  title: string
+  className?: string
+  children: ReactNode
+}) {
+  return (
+    <Box className={`espace-section ${className ?? ''}`}>
+      <Box className="espace-section-head">
+        <Typography className="espace-section-title">
+          {title}
+        </Typography>
+        <Box className="espace-section-rule" />
+      </Box>
+
+      <Box className="espace-section-content">
+        {children}
+      </Box>
+    </Box>
+  )
+}
 
